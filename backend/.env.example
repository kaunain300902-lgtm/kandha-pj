# --- core ---
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://kandha:kandha@localhost:5432/kandha?schema=public

# --- auth ---
# generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=90d
OTP_TTL_SECONDS=300
# in development the OTP is printed to the server log instead of being sent
OTP_DEV_MODE=true

# --- sms provider (MSG91 is the cheapest reliable option in India) ---
SMS_PROVIDER=none          # none | msg91 | twilio
MSG91_AUTH_KEY=
MSG91_SENDER_ID=KANDHA
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- misc ---
CORS_ORIGINS=*
ADMIN_BOOTSTRAP_PHONE=919830000000
